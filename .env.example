PORT=4000
NODE_ENV=development

# --- Local Postgres ---
# DATABASE_URL=postgresql://testuser:test@localhost:5432/university_test
# DATABASE_SSL_MODE=disable

# --- Managed Postgres (Aiven, RDS, etc.) ---
# Use the connection string your provider gives you, including its
# ?sslmode=require query param -- the Prisma CLI (db pull/generate)
# reads SSL settings from the URL itself. Then set DATABASE_SSL_MODE
# below to control how the APPLICATION's connection verifies the cert.
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# disable = no SSL. no-verify = SSL on, any cert accepted (quick
# unblock only, not for real use). verify-full = SSL on, cert
# verified against DATABASE_SSL_CA_PATH -- required for Aiven/most
# managed providers, since they sign with their own CA.
DATABASE_SSL_MODE=verify-full
# Download from your provider's console (Aiven: Service Overview ->
# "CA Certificate" download). Keep this file out of version control.
DATABASE_SSL_CA_PATH=./certs/ca.pem

JWT_ACCESS_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
